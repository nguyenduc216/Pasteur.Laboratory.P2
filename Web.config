<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<configSections>
		<section name="SubSonicService" type="SubSonic.SubSonicSection, SubSonic" requirePermission="false"/>
		<sectionGroup name="system.web.extensions" type="System.Web.Configuration.SystemWebExtensionsSectionGroup, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
			<sectionGroup name="scripting" type="System.Web.Configuration.ScriptingSectionGroup, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
				<section name="scriptResourceHandler" type="System.Web.Configuration.ScriptingScriptResourceHandlerSection, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" allowDefinition="MachineToApplication"/>
				<sectionGroup name="webServices" type="System.Web.Configuration.ScriptingWebServicesSectionGroup, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
					<section name="jsonSerialization" type="System.Web.Configuration.ScriptingJsonSerializationSection, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" allowDefinition="Everywhere" />
					<section name="profileService" type="System.Web.Configuration.ScriptingProfileServiceSection, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" allowDefinition="MachineToApplication" />
					<section name="authenticationService" type="System.Web.Configuration.ScriptingAuthenticationServiceSection, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" allowDefinition="MachineToApplication" />
					<section name="roleService" type="System.Web.Configuration.ScriptingRoleServiceSection, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" allowDefinition="MachineToApplication" />
				</sectionGroup>
			</sectionGroup>
		</sectionGroup>
	</configSections>
	<appSettings/>
	<connectionStrings>
		<add connectionString="Data Source=MINHDUC-LT\SQLSERVER2014;Initial Catalog=Pasteur_QLXN.P2;Persist Security Info=True;User ID=Dev_User;Password=Admin@123" name="Pasteur"/>
		<!--<add connectionString="Data Source=103.231.189.160;Initial Catalog=Pasteur_QLXN;Persist Security Info=True;User ID=SWuser;Password=Admin@123@Abc" name="Pasteur"/>-->
		<add connectionString="Data Source=MINHDUC-LT\SQLSERVER2014;Initial Catalog=Pasteur_QLXN_Log;Persist Security Info=True;User ID=Dev_User;Password=Admin@123" name="Pasteur_Log"/>
	</connectionStrings>
	<SubSonicService defaultProvider="DataAcessProvider" enableTrace="false" templateDirectory="">
		<providers>
			<clear/>
			<add name="DataAcessProvider" type="SubSonic.SqlDataProvider, SubSonic" connectionStringName="Pasteur" generatedNamespace="Pasteur.DataAccess" generateLazyLoads="true"/>
			<add name="DataLogAcessProvider" type="SubSonic.SqlDataProvider, SubSonic" connectionStringName="Pasteur_Log" generatedNamespace="Pasteur.DataAccess" generateLazyLoads="true"/>
		</providers>
	</SubSonicService>
	<system.web>
		<!--<customErrors mode="On" defaultRedirect="404" >
			<error statusCode="500" redirect="/500"/>
			<error statusCode="403" redirect="/403"/>
			<error statusCode="404" redirect="/404"/>
		</customErrors>-->
		<httpRuntime maxRequestLength="20000" executionTimeout="999999"/>
		<compilation debug="true" >
			<assemblies>
				<add assembly="System.Core, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
				<add assembly="System.Data.DataSetExtensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
				<add assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
				<add assembly="System.Xml.Linq, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
			</assemblies>
		</compilation>
		<!--
      The <authentication> section enables configuration 
      of the security authentication mode used by 
      ASP.NET to identify an incoming user. 
    -->
		<authentication mode="Windows" />
		<!--
       The <customErrors> section enables configuration 
       of what to do if/when an unhandled error occurs 
       during the execution of a request. Specifically, 
       it enables developers to configure html error pages 
       to be displayed in place of a error stack trace.

       <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
         <error statusCode="403" redirect="NoAccess.htm" />
         <error statusCode="404" redirect="FileNotFound.htm" />
       </customErrors>
    -->
		<pages>
			<controls>
				<add tagPrefix="SweetSoft" namespace="SweetSoft.ExtraControls" assembly="SweetSoft.ExtraControls"/>
				<add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
				<add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			</controls>
		</pages>

		<httpHandlers>
			<remove verb="*" path="*.asmx"/>
			<add verb="*" path="*.asmx" validate="false" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			<add verb="*" path="*_AppService.axd" validate="false" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			<add verb="GET,HEAD" path="ScriptResource.axd" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" validate="false"/>
		</httpHandlers>
		<httpModules>
			<add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
		</httpModules>
	</system.web>
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" warningLevel="4"
					  type="Microsoft.CSharp.CSharpCodeProvider, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
				<providerOption name="CompilerVersion" value="v3.5"/>
				<providerOption name="WarnAsError" value="false"/>
			</compiler>
		</compilers>
	</system.codedom>
	<!-- 
        The system.webServer section is required for running ASP.NET AJAX under Internet
        Information Services 7.0.  It is not necessary for previous version of IIS.
    -->
	<system.web.extensions>
		<scripting>
			<webServices>
				<jsonSerialization maxJsonLength="50000000"></jsonSerialization>
			</webServices>
		</scripting>
	</system.web.extensions>
	<system.webServer>
		<httpErrors errorMode="Custom">
			<remove statusCode="404"/>
			<error statusCode="404" path="404.aspx" responseMode="Redirect"/>
		</httpErrors>
		<validation validateIntegratedModeConfiguration="false"/>
		<modules>
			<remove name="ScriptModule" />
			<add name="ScriptModule" preCondition="managedHandler" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
		</modules>
		<handlers>
			<remove name="WebServiceHandlerFactory-Integrated"/>
			<remove name="ScriptHandlerFactory" />
			<remove name="ScriptHandlerFactoryAppServices" />
			<remove name="ScriptResource" />
			<add name="ScriptHandlerFactory" verb="*" path="*.asmx" preCondition="integratedMode"
				 type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			<add name="ScriptHandlerFactoryAppServices" verb="*" path="*_AppService.axd" preCondition="integratedMode"
				 type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			<add name="ScriptResource" preCondition="integratedMode" verb="GET,HEAD" path="ScriptResource.axd" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
		</handlers>
		<rewrite>
			<rules>
				<!--login-->
				<rule name=" login with ReturnURL">
					<match url="(.*)loginURL([_0-9a-zA-Z-]+)/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/SystemLogin.aspx?ReturnUrl={R:2}" appendQueryString="false"/>
				</rule>
				<rule name="Admin Login">
					<match url="(.*)login/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/SystemLogin.aspx" appendQueryString="false"/>
				</rule>
				<!--trang chủ-->
				<rule name=" Trang chủ">
					<match url="(.*)trang-chu/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Default.aspx" appendQueryString="false"/>
				</rule>
				<!--trang chủ-->
				<rule name=" Trang chủ 2">
					<match url="(.*)dashboard/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Default.aspx" appendQueryString="false"/>
				</rule>
				<!--vai trò-->
				<rule name="Vai trò người dung">
					<match url="(.*)vai-tro/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/QLVaiTro.aspx" appendQueryString="false"/>
				</rule>
				<!--Người dùng-->
				<rule name=" người dung">
					<match url="(.*)nguoi-dung/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/QLNguoiDung.aspx" appendQueryString="false"/>
				</rule>
				<!--Đơn vị tính-->
				<rule name="don vi tinh">
					<match url="(.*)don-vi-tinh/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/DMDonViTinh.aspx" appendQueryString="false"/>
				</rule>
				<!--Phòng ban-->
				<rule name=" phong ban">
					<match url="(.*)phong-ban/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/DMPhongBan.aspx" appendQueryString="false"/>
				</rule>
				<!--Thay mat khau-->
				<rule name=" Thay mat khau">
					<match url="(.*)thay-mat-khau/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/ThayMatKhau.aspx" appendQueryString="false"/>
				</rule>
				<!--Loai mau-->
				<rule name=" Loai mau">
					<match url="(.*)loai-mau/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatLoaiMau.aspx" appendQueryString="false"/>
				</rule>
				<!--Thong tu-->
				<rule name=" Thong tu">
					<match url="(.*)thong-tu/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatThongTu.aspx" appendQueryString="false"/>
				</rule>
				<!--Gioi han chi tieu-->
				<rule name=" Gioi han chi tieu">
					<match url="(.*)gioi-han-chi-tieu/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatChiTieuGioiHan.aspx" appendQueryString="false"/>
				</rule>
				<!--Phương pháp-->
				<rule name=" phuong phap">
					<match url="(.*)phuong-phap-xet-nghiem/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatPhuongPhap.aspx" appendQueryString="false"/>
				</rule>
				<!--Đơn vị tính-->
				<rule name=" Don vi tinh">
					<match url="(.*)don-vi-tinh/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/DMDonViTinh.aspx" appendQueryString="false"/>
				</rule>
				<!--Quy chuan-->
				<rule name=" Quy chuan">
					<match url="(.*)quy-chuan-xet-nghiem/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatQuyChuan.aspx" appendQueryString="false"/>
				</rule>
				<!--Nhom XN-->
				<rule name=" Nhom xet nghiem">
					<match url="(.*)nhom-xet-nghiem/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatNhomXetNghiem.aspx" appendQueryString="false"/>
				</rule>
				<!--Chung chi-->
				<rule name=" Chung chi">
					<match url="(.*)chung-chi-chung-nhan/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatChungChi.aspx" appendQueryString="false"/>
				</rule>
				<!--Chi tieu xet nghiẹm-->
				<rule name=" Chi tieu xet nghiem">
					<match url="(.*)chi-tieu-xet-nghiem/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/ChiTieuXetNghiem.aspx" appendQueryString="false"/>
				</rule>
				<!--Chi tieu xet nghiệm detail-->
				<rule name=" Chi tieu xet nghiem detal">
					<match url="(.*)chi-tieu-xet-nghiem/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/ChiTieuXetNghiemChiTiet.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Mau xet nghiệm -->
				<rule name=" Mau xet nghiem ">
					<match url="(.*)mau-xet-nghiem?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=PhieuNhanMau" appendQueryString="false"/>
				</rule>
				<!--Mau xet nghiệm detail-->
				<rule name=" Mau xet nghiem detal">
					<match url="(.*)mau-xet-nghiem/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiemChiTiet.aspx?ID={R:2}&amp;PageType=PhieuNhanMau" appendQueryString="false"/>
				</rule>
				<!--Labo Hoa nghiệm -->
				<rule name=" Labo Hoa ">
					<match url="(.*)labo-hoa-tiep-nhan?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=LaboHoaLy" appendQueryString="false"/>
				</rule>
				<!--Labo Hoa  detail-->
				<rule name=" Labo Hoa detal">
					<match url="(.*)labo-hoa-tiep-nhan/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiemChiTiet.aspx?ID={R:2}&amp;PageType=LaboHoaLy" appendQueryString="false"/>
				</rule>
				<!--Labo VS  -->
				<rule name=" Labo VS ">
					<match url="(.*)labo-vs-tiep-nhan?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=LaboViSinh" appendQueryString="false"/>
				</rule>
				<!--ke toan  -->
				<rule name=" Ke toan tiep nhap">
					<match url="(.*)ke-toan-tiep-nhan?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=KeToanTiepNhan" appendQueryString="false"/>
				</rule>

				<!--Tra Ket Qua -->
				<rule name=" Tra Ket Qua ">
					<match url="(.*)tra-ket-qua-xet-nghiem?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=TraKQXN" appendQueryString="false"/>
				</rule>
				<!--Tra Ket Qua Detail-->
				<rule name=" Tra Ket Qua Detail">
					<match url="(.*)tra-ket-qua-xet-nghiem/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiemChiTiet.aspx?ID={R:2}&amp;PageType=TraKQXN" appendQueryString="false"/>
				</rule>
				<!--Thanh Ly Hoa  -->
				<rule name=" Labo Hoa Thanh Ly">
					<match url="(.*)thanh-ly-hoa?$" ignoreCase="true"/>
					<action type="Rewrite" url="/ThanhLy.aspx?PageType=LaboHoaLy" appendQueryString="false"/>
				</rule>
				<!--Thanh Ly  VS  -->
				<rule name=" Labo VS Thanh Ly">
					<match url="(.*)thanh-ly-vs?$" ignoreCase="true"/>
					<action type="Rewrite" url="/ThanhLy.aspx?PageType=LaboViSinh" appendQueryString="false"/>
				</rule>
				<!--Bien ban thanh ly  -->
				<rule name=" Bien ban thanh ly">
					<match url="(.*)bien-ban-thanh-ly/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/BienBanThanhLy.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Labo VS  -->
				<rule name=" Labo VS detal">
					<match url="(.*)labo-vs-tiep-nhan/([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiemChiTiet.aspx?ID={R:2}&amp;PageType=LaboViSinh" appendQueryString="false"/>
				</rule>
				<!--Printing mau tiep nhan-->
				<rule name=" In phieu tiep nhan yeu cau">
					<match url="(.*)phieu-tiep-nhan-yeu-cau-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuTiepNhanYeuCau.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Printing mau tiep nhan-->
				<rule name=" bien-ban-ghi-chep-thu-nghiem">
					<match url="(.*)bien-ban-ghi-chep-thu-nghiem-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/BienBanGhiChepThuNghiem.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Printing noi bo vi sinh-->
				<rule name=" In phieu tra ket qua noi bo vi sinh">
					<match url="(.*)phieu-tra-ket-qua-noi-bo-vs-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNoiBo.aspx?ID={R:2}&amp;PageType=LaboViSinh" appendQueryString="false"/>
				</rule>
				<!--Printing noi bo vi sinh-->
				<rule name=" In phieu tra ket qua noi bo vi sinh M1">
					<match url="(.*)phieu-tra-ket-qua-noi-bo-vs-so-([0-9]+)-m1?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNoiBo.aspx?ID={R:2}&amp;PageType=LaboViSinh&amp;CType=M1" appendQueryString="false"/>
				</rule>
				<!--Printing noi bo vi sinh-->
				<rule name=" In phieu tra ket qua noi bo vi sinh M2">
					<match url="(.*)phieu-tra-ket-qua-noi-bo-vs-so-([0-9]+)-m2?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNoiBo.aspx?ID={R:2}&amp;PageType=LaboViSinh&amp;CType=M2" appendQueryString="false"/>
				</rule>
				<!--Printing phieu chuyen mau-->
				<rule name=" In phieu chuyen mau">
					<match url="(.*)phieu-chuyen-mau-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuChuyenMau.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Printing noi bo hoa-->
				<rule name=" In phieu tra ket qua noi bo hoa">
					<match url="(.*)phieu-tra-ket-qua-noi-bo-hoa-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNoiBo.aspx?ID={R:2}&amp;PageType=LaboHoaLy" appendQueryString="false"/>
				</rule>

				<rule name=" In phieu phieu tra ket qua paging">
					<match url="(.*)phieu-tra-ket-qua-so-([0-9]+)-P([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNew2P.aspx?ID={R:2}&amp;CPage={R:3}" appendQueryString="false"/>
				</rule>
				<!--Printing phieu tra ket qua -->
				<rule name=" In phieu phieu tra ket qua ">
					<match url="(.*)phieu-tra-ket-qua-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNew2P.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Printing phieu tra ket qua mau -->
				<rule name=" In phieu phieu tra ket qua mau so 1">
					<match url="(.*)phieu-tra-ket-qua-so-([0-9]+)-m1?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNew2P.aspx?ID={R:2}&amp;CType=M1" appendQueryString="false"/>
				</rule>
				<!--Printing phieu tra ket qua mau -->
				<rule name=" In phieu phieu tra ket qua mau s0 2">
					<match url="(.*)phieu-tra-ket-qua-so-([0-9]+)-m2?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuKetQuaNew2P.aspx?ID={R:2}&amp;CType=M2" appendQueryString="false"/>
				</rule>
				<!--Printing phieu tra ket qua -->
				<rule name=" In phieu phieu tra ket qua in phoi">
					<match url="(.*)phieu-tra-ket-qua-in-phoi-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PrintPhieuKetQuaKiermNghiemPhoi.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Printing giấy đề nghị thu tiền -->
				<rule name=" In phieu de nghi thu tien ">
					<match url="(.*)phieu-de-nghi-thu-tien-so-([0-9]+)?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Printing/PhieuDeNghiThuTien.aspx?ID={R:2}" appendQueryString="false"/>
				</rule>
				<!--Loai hinh yeu cau-->
				<rule name=" Loai hinh yeu cau">
					<match url="(.*)loai-hinh-yeu-cau/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/CatLoaiHinhYeuCau.aspx" appendQueryString="false"/>
				</rule>
				<!--Thống kê theo chỉ tiêu-->
				<rule name=" Thong ke chi tieu">
					<match url="(.*)thong-ke-chi-tieu/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/BaoCaoChiTieu.aspx" appendQueryString="false"/>
				</rule>
				<!--Báo cáo tổng hợp kết quả-->
				<rule name=" Bao cao tong hop ket qua">
					<match url="(.*)bao-cao-tong-hop-ket-qua/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/BaoCaoTongHopKetQua.aspx" appendQueryString="false"/>
				</rule>
				<!--Thống kê theo chỉ tiêu loại mẫu quy chuẩn-->
				<rule name=" Thong ke chi tieu qc">
					<match url="(.*)thong-ke-theo-qc/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/TKLuongMauTheoQuyChuan.aspx" appendQueryString="false"/>
				</rule>
				<rule name=" Thong ke chi tieu ctqc">
					<match url="(.*)thong-ke-theo-ctqc/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/TKLuongMauTheoChiTieuQuyChuan.aspx" appendQueryString="false"/>
				</rule>
				<rule name=" Thong ke mau thanh ly">
					<match url="(.*)thong-ke-mau-thanh-ly/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/ReportThanhLy.aspx" appendQueryString="false"/>
				</rule>
				<rule name=" Thong ke doanh thu">
					<match url="(.*)bao-cao-doanh-thu/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/Reports/BaoCaoDoanhThu.aspx" appendQueryString="false"/>
				</rule>
				<!--403-->
				<rule name=" 403">
					<match url="(.*)403/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/403.aspx" appendQueryString="false"/>
				</rule>
				<!--404-->
				<rule name=" 404">
					<match url="(.*)404/?$" ignoreCase="true"/>
					<action type="Rewrite" url="/404.aspx" appendQueryString="false"/>
				</rule>
				<!--New-->
				<rule name=" New">
					<match url="(.*)mau-xet-nghiem/new?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?Code=New&amp;PageType=PhieuNhanMau" appendQueryString="false"/>
				</rule>
				<!--Cho Tra KQ-->
				<rule name="Cho-Tra-KQ">
					<match url="(.*)mau-xet-nghiem/cho-tra-kq?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?Code=ChoTraKQ&amp;PageType=PhieuNhanMau" appendQueryString="false"/>
				</rule>
				<!--Cho Tra KQ HOa-->
				<rule name="Cho-Tra-KQ-Hoa">
					<match url="(.*)labo-hoa-tiep-nhan/cho-danh-gia-kq?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?Code=ChoDGKQ&amp;PageType=LaboHoaLy" appendQueryString="false"/>
				</rule>
				<!--Cho Tra KQ VS-->
				<rule name="Cho-Tra-KQ-VS">
					<match url="(.*)labo-vs-tiep-nhan/cho-danh-gia-kq?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?Code=ChoDGKQ&amp;PageType=LaboViSinh" appendQueryString="false"/>
				</rule>
				<!--Ke toan thu tien -->
				<rule name="ke-toan-thu-tien">
					<match url="(.*)ke-toan-tiep-nhan/thu-tien?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?Code=ThuTien&amp;PageType=KeToanTiepNhan" appendQueryString="false"/>
				</rule>
				<!--Thanh ly mau -->
				<rule name=" Thanh ly mau ">
					<match url="(.*)tra-ket-qua-xet-nghiem/chua-thanh-ly?$" ignoreCase="true"/>
					<action type="Rewrite" url="/MauXetNghiem.aspx?PageType=TraKQXN&amp;Code=ChuaThanhLy" appendQueryString="false"/>
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
	<runtime>
		<assemblyBinding appliesTo="v2.0.50727" xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Extensions" publicKeyToken="31bf3856ad364e35"/>
				<bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="3.5.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Extensions.Design" publicKeyToken="31bf3856ad364e35"/>
				<bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="3.5.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

</configuration>
